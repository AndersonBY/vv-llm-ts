{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vv-llm-contract:chat-request:v1",
  "title": "vv-llm canonical chat request v1",
  "$comment": "Canonical objects are closed except for optional x_* provider-neutral extensions. Opaque JSON fields are intentionally open and must not be interpreted by the contract.",
  "type": "object",
  "required": [
    "model",
    "messages"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "options": {
      "$ref": "#/$defs/chat_request_options"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chat_tool"
      }
    },
    "tool_choice": {
      "$ref": "#/$defs/tool_choice"
    },
    "extra_body": {
      "$ref": "#/$defs/json_object"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]*$": {}
  },
  "additionalProperties": false,
  "$defs": {
    "json_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "$ref": "#/$defs/json_object"
        }
      ]
    },
    "json_object": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    },
    "message": {
      "type": "object",
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/content_part"
              }
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        },
        "reasoning_content": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]*$": {}
      },
      "additionalProperties": false
    },
    "content_part": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "cache_control": {
              "$ref": "#/$defs/json_value"
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]*$": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "image_url"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "enum": [
                "auto",
                "low",
                "high"
              ]
            },
            "cache_control": {
              "$ref": "#/$defs/json_value"
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]*$": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "image_url"
          ],
          "properties": {
            "type": {
              "const": "image_url"
            },
            "image_url": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "enum": [
                    "auto",
                    "low",
                    "high"
                  ]
                }
              },
              "patternProperties": {
                "^x_[a-z][a-z0-9_]*$": {}
              },
              "additionalProperties": false
            },
            "cache_control": {
              "$ref": "#/$defs/json_value"
            }
          },
          "patternProperties": {
            "^x_[a-z][a-z0-9_]*$": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "chat_tool": {
      "type": "object",
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/json_value"
        },
        "cache_control": {
          "$ref": "#/$defs/json_value"
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]*$": {}
      },
      "additionalProperties": false
    },
    "tool_call": {
      "type": "object",
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "extra_content": {
          "$ref": "#/$defs/json_value"
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]*$": {}
      },
      "additionalProperties": false
    },
    "tool_choice": {
      "oneOf": [
        {
          "enum": [
            "auto",
            "required",
            "none"
          ]
        },
        {
          "$ref": "#/$defs/json_object"
        }
      ]
    },
    "thinking": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "default",
            "enabled",
            "disabled",
            "adaptive",
            "provider_defined"
          ]
        },
        "budget_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "$ref": "#/$defs/json_value"
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]*$": {}
      },
      "additionalProperties": false
    },
    "chat_request_options": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "stream": {
          "type": "boolean"
        },
        "top_p": {
          "type": "number",
          "minimum": 0
        },
        "stop": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "response_format": {
          "$ref": "#/$defs/json_value"
        },
        "stream_options": {
          "$ref": "#/$defs/json_value"
        },
        "audio": {
          "$ref": "#/$defs/json_value"
        },
        "frequency_penalty": {
          "type": "number"
        },
        "logit_bias": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "logprobs": {
          "type": "boolean"
        },
        "max_tokens_details": {
          "$ref": "#/$defs/json_value"
        },
        "metadata": {
          "$ref": "#/$defs/json_value"
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "prediction": {
          "$ref": "#/$defs/json_value"
        },
        "presence_penalty": {
          "type": "number"
        },
        "reasoning_effort": {
          "type": "string"
        },
        "thinking": {
          "$ref": "#/$defs/thinking"
        },
        "seed": {
          "type": "integer"
        },
        "service_tier": {
          "type": "string"
        },
        "store": {
          "type": "boolean"
        },
        "top_logprobs": {
          "type": "integer",
          "minimum": 0
        },
        "user": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x_[a-z][a-z0-9_]*$": {}
      },
      "additionalProperties": false
    }
  }
}
